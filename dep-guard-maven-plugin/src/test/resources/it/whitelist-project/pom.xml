<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.depguard.it</groupId>
  <artifactId>whitelist-project</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>
  <dependencies>
    <dependency><groupId>com.sample</groupId><artifactId>lib-a</artifactId><version>1.0</version></dependency>
    <dependency><groupId>com.sample</groupId><artifactId>lib-b</artifactId><version>1.0</version></dependency>
    <dependency><groupId>com.sample</groupId><artifactId>lib-c</artifactId><version>1.0</version></dependency>
  </dependencies>
  <build>
    <directory>target</directory>
    <plugins>
      <plugin>
        <groupId>io.github.depguard</groupId>
        <artifactId>dep-guard-maven-plugin</artifactId>
        <version>1.0.0</version>
        <configuration>
          <ignoredDependencies>
            <ignoredDependency>com.sample:lib-a</ignoredDependency>
          </ignoredDependencies>
          <ignoredClasses>
            <ignoredClass>com.sample.shared.Foo</ignoredClass>
          </ignoredClasses>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
